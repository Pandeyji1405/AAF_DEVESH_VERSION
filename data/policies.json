{
  "risk_tiers": {
    "R0": {
      "name": "Diagnostic Read",
      "description": "Read-only inspection of telemetry, identity, or asset state.",
      "requires_human_approval": false,
      "auto_executable": true
    },
    "R1": {
      "name": "Low-Impact Reversible Write",
      "description": "Sync triggers, audit notes, ticket updates, local cache cleanups.",
      "requires_human_approval": false,
      "auto_executable": true
    },
    "R2": {
      "name": "Standard User Impacting Write",
      "description": "Adding group memberships, license assignments, device reboots, patches, hardware replacement orders.",
      "requires_human_approval": true,
      "approver_roles": ["MANAGER", "IT_DIRECTOR", "SECURITY_ADMIN"],
      "auto_executable": false
    },
    "R3": {
      "name": "High Privilege / Destructive Action",
      "description": "SQL transaction log truncation, privileged roles, endpoint isolation, device wipe/retire.",
      "requires_human_approval": true,
      "approver_roles": ["LEAD_DBA", "CAB_APPROVER", "SECURITY_ADMIN"],
      "auto_executable": false
    },
    "R4": {
      "name": "Prohibited Autonomous Action",
      "description": "Disabling conditional access policies, security perimeter modification.",
      "requires_human_approval": true,
      "auto_executable": false
    }
  },
