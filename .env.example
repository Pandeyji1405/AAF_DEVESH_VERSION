# Enterprise Environment Configuration
# Configured for Microsoft Agent Framework (MAF) with Google Gemini API

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-2.0-flash

# Manager Email & Approval Webhook Configuration
APPROVER_EMAIL_OVERRIDE=devesh.pandey1405@gmail.com
PUBLIC_BASE_URL=http://localhost:8000
APPROVAL_SECRET_KEY=maf-enterprise-approval-secret-key-2026

# Live Gmail SMTP/IMAP Settings for Dispatching & Polling Approval Emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM=your_email@gmail.com

# ══════════════════════════════════════════════════════════════════════════════
# ServiceNow Direct Table API REST Connection
# ══════════════════════════════════════════════════════════════════════════════
SERVICENOW_INSTANCE_URL=https://dev00000.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=your_servicenow_password_here

# ══════════════════════════════════════════════════════════════════════════════
# AutomationEdge T4 Server REST Connection (https://t4.automationedge.com)
# ══════════════════════════════════════════════════════════════════════════════
AE_BASE_URL=https://t4.automationedge.com
AE_ORG_CODE=US_MSP
AE_USERNAME=your_t4_username
AE_PASSWORD=your_t4_password
AE_EXECUTION_USER=your_t4_username

# AutomationEdge T4 Published Workflow Names for ServiceNow Operations
AE_WORKFLOW_CREATE_INCIDENT=Servicenow_Incident_Creation
AE_WORKFLOW_UPDATE_INCIDENT=ServiceNow_Update_Incident
